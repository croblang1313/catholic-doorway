{
  // Cloudflare Worker: static site in ./site plus a tiny readings API in worker/index.js.
  "name": "catholic-doorway",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Parish OCIA listings (worker/ocia.js). ADMIN_TOKEN is a secret set in the Cloudflare dashboard.
  // Weekly check of parish livestream links (Mondays 09:17 UTC), see checkStreams() in worker/ocia.js.
  "triggers": { "crons": ["17 9 * * 1"] },
  "kv_namespaces": [
    { "binding": "LISTINGS", "id": "620302b821b94992896465fb08f6aa43" }
  ]
}
